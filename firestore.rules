rules_version = '2';

// Lab 3.3 · Security Rules ของบ้านบรู (Prompt 3.3B)
// web config อยู่ในหน้าเว็บให้ทุกคนเห็น ความปลอดภัยจริงจึงอยู่ที่ไฟล์นี้
// หลักคิด: ปิดทุกอย่างเป็นค่าเริ่มต้น แล้วเปิดเฉพาะที่หน้าเว็บต้องใช้จริง
// (scripts/seed.mjs ใช้ Admin SDK ซึ่งข้าม rules ได้ จึงยังนำเข้าข้อมูลได้ตามปกติ)
service cloud.firestore {
  match /databases/{database}/documents {

    // ล็อกอินแล้ว และยืนยันอีเมลแล้ว
    // บัญชี Google ยืนยันมาแล้วเสมอ ส่วนบัญชีอีเมลต้องกดลิงก์ยืนยันก่อน
    // ไม่งั้นใครก็สมัครด้วยอีเมลของคนอื่นแล้วเข้ามาอ่านยอดขายได้
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // เอกสารยอดขายที่ส่งมาต้องมีรูปแบบเดียวกับที่ buildSale() ใน src/lab3/saleModel.js สร้าง + created_at
    function validSale() {
      let d = request.resource.data;
      let fields = ['order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty',
                    'unit_price', 'revenue', 'customer_id', 'payment_method', 'channel',
                    'source', 'created_by', 'created_at'];
      let product = /databases/$(database)/documents/products/$(d.product_id);
      return
        // ฟิลด์ครบ (hasAll) และไม่มีฟิลด์เกิน (hasOnly) เช่นแอบเพิ่ม discount ไม่ได้
        d.keys().hasAll(fields) && d.keys().hasOnly(fields)

        // มาจากหน้าเว็บเท่านั้น (ข้อมูล import ใช้ source = "import" ผ่าน Admin SDK)
        && d.source == 'web'
        // ผู้บันทึกต้องเป็นคนที่ล็อกอินอยู่ ปลอมเป็น uid ของคนอื่นไม่ได้
        && d.created_by == request.auth.uid
        // เวลาบันทึกต้องเป็นเวลาเซิร์ฟเวอร์ (serverTimestamp()) ใส่เวลาเองย้อนหลังไม่ได้
        && d.created_at == request.time

        // สาขาต้องเป็น 1 ใน 5 สาขาที่มีจริง
        && d.branch in ['สยาม', 'สีลม', 'อารีย์', 'บางนา', 'มหาวิทยาลัย']
        // วิธีชำระเงินต้องเป็น 1 ใน 5 แบบที่ร้านรับ
        && d.payment_method in ['QR พร้อมเพย์', 'บัตรเครดิต', 'เงินสด', 'LINE MAN', 'Grab']
        // ช่องทางต้องตรงกับวิธีชำระเงิน: LINE MAN/Grab = เดลิเวอรี นอกนั้น = หน้าร้าน
        && d.channel == ((d.payment_method in ['LINE MAN', 'Grab']) ? 'เดลิเวอรี' : 'หน้าร้าน')

        // จำนวนเป็นจำนวนเต็ม 1–20 (ติดลบหรือ 1.5 ไม่ได้)
        && d.qty is int && d.qty >= 1 && d.qty <= 20
        // ชั่วโมงเป็นจำนวนเต็ม 0–23
        && d.hour is int && d.hour >= 0 && d.hour <= 23

        // เมนูต้องมีอยู่จริง และราคาต้องตรงกับราคาใน products/{product_id}
        // (ตั้งราคาเองไม่ได้ เช่น ลาเต้เย็น ฿1)
        && d.product_id is string && exists(product)
        && d.unit_price == get(product).data.price
        // ยอดรวมต้องเท่ากับ จำนวน × ราคา พอดี
        && d.revenue == d.qty * d.unit_price

        // วันที่ YYYY-MM-DD และวันเวลา YYYY-MM-DDTHH:MM:SS+07:00 (เวลาไทย)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.datetime is string
        && d.datetime.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+]07:00$')
        // date และ hour ต้องตรงกับ datetime (ไม่งั้นยอดไปโผล่ผิดวัน/ผิดชั่วโมงในกราฟ)
        && d.datetime.split('T')[0] == d.date
        && int(d.datetime.split('T')[1].split(':')[0]) == d.hour

        // รหัสสมาชิกเป็น null (ไม่ใช่สมาชิก) หรือ C ตามด้วยเลข 5 หลัก
        && (d.customer_id == null || (d.customer_id is string && d.customer_id.matches('^C[0-9]{5}$')))

        && d.order_id is string;
    }

    // เมนูและสาขา: อ่านได้เมื่อล็อกอิน แก้จากหน้าเว็บไม่ได้ (แก้ได้เฉพาะ seed script / console)
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /branches/{branchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ยอดขาย: อ่านได้เมื่อล็อกอิน สร้างใหม่ได้เมื่อข้อมูลถูกต้องครบ
    // แก้ไขและลบไม่ได้ (ยอดขายที่บันทึกแล้วต้องคงเดิม ถ้าผิดให้บันทึกรายการแก้แทน)
    match /sales/{saleId} {
      allow read: if signedIn();
      allow create: if signedIn() && validSale();
      allow update, delete: if false;
    }

    // collection อื่นที่ไม่ได้ระบุไว้: ปิดทั้งหมด (rules ไม่มี allow = ไม่อนุญาต)
  }
}
