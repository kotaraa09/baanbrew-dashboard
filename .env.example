# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase console
# Project settings → General → Your apps → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ใช้กับ npm run seed / verify-import เท่านั้น (ไม่ถูกส่งไปหน้าเว็บ เพราะไม่ขึ้นต้นด้วย VITE_)
# ไฟล์ key ต้องอยู่ในโฟลเดอร์ secrets/ ห้าม commit
FIREBASE_SERVICE_ACCOUNT=./secrets/service-account.json

# บัญชีทดสอบสำหรับล็อกอินด้วยอีเมล (npm run create-test-user) · ตั้งรหัสผ่านเอง อย่างน้อย 6 ตัว
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=
